# ─── Côté navigateur (publiques : visibles dans le code envoyé aux utilisateurs) ───
# Adresse de votre projet Supabase (Supabase > Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé PUBLIQUE (anon / publishable). JAMAIS la clé secrète « service_role ».
VITE_SUPABASE_ANON_KEY=
# Domaine des emails techniques des boutiques (identifiant@domaine). Pas besoin d’une vraie boîte mail.
VITE_AUTH_EMAIL_DOMAIN=shops.jago.app

# ─── Côté serveur uniquement (fonctions /api sur Vercel) : NE JAMAIS préfixer par VITE_ ───
# Utilisées à partir de la Phase 9. Définissez-les dans Vercel > Settings > Environment Variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_EMAIL_DOMAIN=shops.jago.app
